{
  "name": "ai-readiness-check",
  "version": "0.2.0",
  "description": "Check how ready a website is for AI crawlers, AI search, and AI agents: robots.txt, llms.txt, schema.org JSON-LD, Markdown pages, MCP discovery, and more. CLI, CI, and MCP.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-readiness-check": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "schema.json"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "ai-readiness",
    "llms-txt",
    "robots-txt",
    "ai-crawlers",
    "ai-agents",
    "mcp",
    "schema-org",
    "json-ld",
    "seo",
    "ci",
    "lighthouse"
  ],
  "homepage": "https://www.tristandenyer.com/ai-readiness-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tristandenyer/ai-readiness-check.git"
  },
  "bugs": {
    "url": "https://github.com/tristandenyer/ai-readiness-check/issues"
  },
